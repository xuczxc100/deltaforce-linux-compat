+/*****************************************************************
+ *           NtUserGetWindowBand (win32u.@)
+ */
+BOOL WINAPI NtUserGetWindowBand( HWND hwnd, DWORD *band )
+{
+    DWORD desktop_band = 1; /* ZBID_DESKTOP: Wine implements no other window bands. */
+    SIZE_T written = 0;
+
+    if (!NtUserQueryWindow( hwnd, WindowProcess ))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    if (!band)
+    {
+        RtlSetLastWin32Error( ERROR_NOACCESS );
+        return FALSE;
+    }
+    if (NtWriteVirtualMemory( GetCurrentProcess(), band, &desktop_band,
+                              sizeof(desktop_band), &written ) || written != sizeof(desktop_band))
+    {
+        RtlSetLastWin32Error( ERROR_NOACCESS );
+        return FALSE;
+    }
+    return TRUE;
+}
